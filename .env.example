# ==============================================================================
# YALA LEOPARD TRACKS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Framework Settings
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=your-django-secret-key-here

# ------------------------------------------------------------------------------
# 2. Live MongoDB Atlas SRV Cloud Database Configuration
# ------------------------------------------------------------------------------
USE_MONGODB=True
MONGODB_NAME=leopardtracks_db
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leopardtracks_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Official Gmail SMTP Email Dispatch & Admin Notification Desk
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=discoveryala0@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password
DEFAULT_FROM_EMAIL=Discoveryala <discoveryala0@gmail.com>
ADMIN_NOTIFICATION_EMAIL=discoveryala0@gmail.com,pasinduwickramasooriya@gmail.com

# ------------------------------------------------------------------------------
# 4. Cloudinary Cloud Image Storage Credentials
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=ddcismwuy
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ------------------------------------------------------------------------------
# 5. Safari Desk Contact Information & Hotline
# ------------------------------------------------------------------------------
HOTLINE_PHONE=+94 778158004
HOTLINE_WHATSAPP=https://wa.me/94778158004
